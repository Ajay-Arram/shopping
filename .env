# ==============================================================================
# SHOPPING CART - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Django Secret Key & Debug Mode
SECRET_KEY=django-insecure-shopping-cart-secure-random-key-development-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# MySQL Database Settings
DB_NAME=shopping_cart
DB_USER=root
DB_PASSWORD=Mysql@123
DB_HOST=localhost
DB_PORT=3306

# Amazon Authorized Product API Credentials (Amazon Associates PA-API 5.0)
# To obtain credentials:
# 1. Sign up at Amazon Associates: https://affiliate-program.amazon.in/
# 2. Go to Tools -> Product Advertising API -> Add Credentials
# 3. Enter your Access Key, Secret Key, and Partner Tag (Tracking ID) below.
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_HOST=webservices.amazon.in
AMAZON_REGION=eu-west-1

# Alternative Authorized Product API (RapidAPI Amazon Data API)
# Get a key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-amazon-data
RAPIDAPI_KEY=
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com

# Alternative Authorized Product API (Rainforest API)
# Get a key at: https://rainforestapi.com/
RAINFOREST_API_KEY=
