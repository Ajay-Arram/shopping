# ==============================================================================
# SHOPPING CART - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your Supabase or database credentials.
# ==============================================================================

# Django Secret Key & Debug Mode
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:5500,http://127.0.0.1:5500

# Production Database: Supabase PostgreSQL via Connection Pooler (IPv4 compatible)
# To obtain from Supabase:
# 1. Open Supabase Dashboard -> Choose your Project
# 2. Go to Project Settings -> Database
# 3. Under "Connection string", select "URI" and choose "Connection pooler" (Session: 5432 or Transaction: 6543)
# 4. Replace [YOUR-PASSWORD] with your actual Supabase database password
# Example: postgresql://postgres.abcdefghijklmno:YourPassword123@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Local Development Database (MySQL fallback if DATABASE_URL is left blank)
DB_NAME=shopping_cart
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Amazon Authorized Product API Credentials (Amazon Associates PA-API 5.0)
# To obtain credentials:
# 1. Sign up at Amazon Associates: https://affiliate-program.amazon.in/
# 2. Go to Tools -> Product Advertising API -> Add Credentials
# 3. Enter your Access Key, Secret Key, and Partner Tag (Tracking ID) below.
AMAZON_API_KEY=your_amazon_access_key
AMAZON_API_SECRET=your_amazon_secret_key
AMAZON_PARTNER_TAG=your_amazon_partner_tag-21
AMAZON_HOST=webservices.amazon.in
AMAZON_REGION=eu-west-1

# Alternative Authorized Product API (RapidAPI Amazon Data API)
# Get a key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-amazon-data
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com

# Alternative Authorized Product API (Rainforest API)
# Get a key at: https://rainforestapi.com/
RAINFOREST_API_KEY=your_rainforest_api_key
